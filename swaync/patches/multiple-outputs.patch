diff --git a/src/notificationWindow/notificationWindows.vala b/src/notificationWindow/notificationWindows.vala
new file mode 100644
index 0000000..8f1cee7
--- /dev/null
+++ b/src/notificationWindow/notificationWindows.vala
@@ -0,0 +1,92 @@
+namespace SwayNotificationCenter {
+    // One shared notification daemon and history, with a popup window per output.
+    public class NotificationWindows : Object {
+        private Gee.HashMap<string, NotificationWindow> windows = new Gee.HashMap<string, NotificationWindow> ();
+        private Gee.ArrayList<NotificationWindow> enabled = new Gee.ArrayList<NotificationWindow> ();
+
+        public bool visible {
+            get {
+                foreach (var window in windows.values) {
+                    if (window.visible) return true;
+                }
+                return false;
+            }
+        }
+
+        public NotificationWindows () {
+            refresh ();
+            app.config_reload.connect (() => refresh ());
+            monitors.items_changed.connect (() => refresh ());
+        }
+
+        private void refresh () {
+            enabled.clear ();
+            string outputs = ConfigModel.instance.notification_window_outputs;
+            // Empty means the stock single-output behavior. "none" means no popups.
+            string[] names = outputs == "" ? new string[] { "" } : outputs.split (",");
+            foreach (string name in names) {
+                if (name == "none") continue;
+                if (name != "" && Functions.try_get_monitor (name) == null) continue;
+                NotificationWindow ?window = windows.get (name);
+                if (window == null) {
+                    window = new NotificationWindow (name == "" ? null : name);
+                    windows.set (name, window);
+                    app.add_window (window);
+                }
+                if (name != "") window.set_monitor (Functions.try_get_monitor (name));
+                if (!enabled.contains (window)) enabled.add (window);
+            }
+            foreach (var window in windows.values) {
+                if (!enabled.contains (window)) window.remove_all_notifications (false, null);
+            }
+        }
+
+        public void add_notification (NotifyParams param) {
+            foreach (var window in enabled) window.add_notification (param);
+        }
+
+        public void replace_notification (uint32 id, NotifyParams param) {
+            foreach (var window in enabled) window.replace_notification (id, param);
+        }
+
+        public void remove_notification (uint32 id) {
+            foreach (var window in windows.values) window.remove_notification (id);
+        }
+
+        public void remove_all_notifications (bool transition, notification_filter_func ?filter) {
+            // Evaluate dismissal side effects only once for each mirrored notification.
+            var decisions = new Gee.HashMap<uint32, bool> ();
+            foreach (var window in windows.values) {
+                window.remove_all_notifications (transition, (notification) => {
+                    uint32 id = notification.param.applied_id;
+                    if (!decisions.has_key (id)) {
+                        decisions.set (id, filter == null || filter (notification));
+                    }
+                    return decisions.get (id);
+                });
+            }
+        }
+
+        private NotificationWindow ?latest_window () {
+            foreach (var window in enabled) {
+                if (window.visible) return window;
+            }
+            return null;
+        }
+
+        public NotifyParams ?get_latest_notification () {
+            var window = latest_window ();
+            return window == null ? null : window.get_latest_notification ();
+        }
+
+        public void latest_notification_action (uint32 action) {
+            var window = latest_window ();
+            if (window != null) window.latest_notification_action (action);
+        }
+
+        public void set_monitor (Gdk.Monitor ?monitor) {
+            var window = windows.get ("");
+            if (window != null) window.set_monitor (monitor);
+        }
+    }
+}
