{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "ignore-gtk-theme": true,
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "cssPriority": "user",
    "control-center-margin-top": 8,
    "control-center-margin-right": 8,
    "control-center-margin-bottom": 8,
    "control-center-width": 600,
    "control-center-height": 600,
    "notification-window-width": 600,
    "notification-window-preferred-output": "DP-2",
    "timeout": 8,
    "timeout-low": 4,
    "timeout-critical": 0,
    "keyboard-shortcuts": true,
    "notification-grouping": true,
    "hide-on-clear": false,
    "hide-on-action": true,
    "widgets": [
        "title",
        "dnd",
        "label#notification-monitor",
        "buttons-grid#notification-monitor",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "label#notification-monitor": {
            "text": "Show notifications on",
            "max-lines": 1
        },
        "buttons-grid#notification-monitor": {
            "buttons-per-row": 2,
            "actions": [
                {
                    "label": "Primary",
                    "type": "toggle",
                    "active": false,
                    "command": "python3 ~/.config/swaync/scripts/notification-monitor.py DP-1"
                },
                {
                    "label": "Second",
                    "type": "toggle",
                    "active": true,
                    "command": "python3 ~/.config/swaync/scripts/notification-monitor.py DP-2"
                }
            ]
        },
        "notifications": {
            "vexpand": true
        }
    }
}
