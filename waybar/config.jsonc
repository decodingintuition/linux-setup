{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces", "custom/layout", "hyprland/window"],
    "modules-center": ["custom/clock"],
    "modules-right": [
      "cpu",
      "memory",
      "custom/mouse",
      "custom/keyboard",
      "custom/headphones",
      "network",
      "pulseaudio",
      "tray"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    "custom/layout": {
        "exec": "~/.config/hypr/scripts/layout-status.sh",
        "interval": 1,
        "signal": 8,
        "format": "{}",
        "tooltip": false
    },

    "custom/clock": {
        "exec": "date '+%a %b %-d %-I:%M %p'",
        "interval": 1,
        "format": "  {}",
        "tooltip": false
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "network": {
        "format-ethernet": "󰈀 {bandwidthDownBytes}",
        "format-disconnected": "󰖪 disconnected",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰸈 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "custom/mouse": {
        "exec": "~/.config/waybar/scripts/battery.py mouse --model \"Keychron M6\" --watch",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": true
    },

    "custom/keyboard": {
        "exec": "~/.config/waybar/scripts/battery.py keyboard --model \"Air75\" --watch",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": true
    },

    "custom/headphones": {
        "exec": "~/.config/waybar/scripts/battery.py headphones --model \"AirPods Max\" --watch",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": true
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
}
